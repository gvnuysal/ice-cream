<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Gvn.IceCream.MAUI.ViewModels"
             x:Class="Gvn.IceCream.MAUI.Pages.SignupPage"
             Title="Signup"
             Shell.FlyoutBehavior="Disabled"
             x:DataType="vm:AuthViewModel">

    <Grid>
        <VerticalStackLayout VerticalOptions="Center"
                             Padding="20"
                             Spacing="15">
            <Image Source="ice_cream"
                   HeightRequest="150"
                   WidthRequest="150"
                   Aspect="AspectFit"/>
            <Entry Text="{Binding Name}" 
                   Placeholder="Name" />
            <Entry Text="{Binding Email}"
                   Keyboard="Email"
                   Placeholder="Email" />
            <Entry Text="{Binding Password}" 
                   Placeholder="Password"
                   IsPassword="True"/>
            <Editor Text="{Binding Address}" 
                   Placeholder="Address"
                   MaxLength="150"
                   AutoSize="TextChanges"/>
            <Label Text="Existing user? Signin"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="DeepPink"
                   x:Name="isExistingUser"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SigninLabel_Tapped" />
                </Label.GestureRecognizers>
            </Label>
            <Button Text="Signup" 
                    Command="{Binding SignupCommand}"
                    IsEnabled="{Binding CanSignup}"/>
        </VerticalStackLayout>
        <ActivityIndicator HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="DeepPink"
                           IsRunning="{Binding IsBusy}"/>
    </Grid>
</ContentPage>